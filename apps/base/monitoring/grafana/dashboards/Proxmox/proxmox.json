        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "system_pressurecpusome{object=~\"qemu|lxc\", nodename=~\"$node\"} / 100",
          "legendFormat": "{{host}} ({{vmid}})",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
