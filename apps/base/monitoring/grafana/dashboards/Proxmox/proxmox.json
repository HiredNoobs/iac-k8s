        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "-rate(nics_transmit{object=\"nodes\", host=~\"$node\", instance!~\"tap.*|fw.*|veth.*|lo\"}[1m])",
          "legendFormat": "{{host}} {{instance}} out",
          "range": true,
          "instant": false
        }
      ],
