        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(nics_receive{object=\"nodes\", host=~\"$node\", instance!~\"tap.*|fw.*|veth.*|lo\"}[1m])",
          "legendFormat": "{{host}} {{instance}} in",
          "range": true,
          "instant": false
