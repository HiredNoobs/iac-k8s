        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "queries",
                "destinationType": "number"
              },
              {
                "targetField": "clients",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true
            },
            "indexByName": {
              "dns.question.name": 0,
              "queries": 1,
              "clients": 2,
              "Time": 3
            },
            "renameByName": {
              "dns.question.name": "Domain",
              "queries": "Queries",
              "clients": "Clients",
              "Time": "Last seen"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
