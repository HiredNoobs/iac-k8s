          "queryType": "instant",
          "expr": "_time:$__range {event.dataset=\"syslog.log\"} host.ip:=\"192.168.111.1\" network.protocol:=dns event.action:=dns-query | stats by (dns.question.name) count() as queries, count_uniq(client.ip) as clients, max(_time) as _time | sort by (queries desc) | limit 100"
