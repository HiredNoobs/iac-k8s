      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(authelia_authn{banned=\"true\"}[$__range])) or vector(0)) + (sum(increase(authelia_authn_second_factor{banned=\"true\"}[$__range])) or vector(0))",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
