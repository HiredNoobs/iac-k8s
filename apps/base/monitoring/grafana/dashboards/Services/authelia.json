    {
      "type": "stat",
      "title": "Banned attempts",
      "id": 6,
      "description": "Attempts refused because the user was banned by regulation (too many failures).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
