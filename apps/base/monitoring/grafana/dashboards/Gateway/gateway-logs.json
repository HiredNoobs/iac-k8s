    {
      "type": "table",
      "title": "Sites",
      "id": 13,
      "description": "Each site's requests, errors, clients and p95 duration.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "_time:$__range {event.dataset=\"envoy.access\"} url.domain:~\"${site}\" | stats by (url.domain) count() as requests, count() if (http.response.status_code:range[400, 500)) as client_errors, count() if (http.response.status_code:>=500) as server_errors, count_uniq(source.ip) as clients, quantile(0.95, event.duration) as p95, max(_time) as _time | sort by (requests desc) | limit 50"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "requests",
                "destinationType": "number"
              },
              {
                "targetField": "client_errors",
                "destinationType": "number"
              },
              {
                "targetField": "server_errors",
                "destinationType": "number"
              },
              {
                "targetField": "clients",
                "destinationType": "number"
              },
              {
                "targetField": "p95",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true
            },
            "indexByName": {
              "url.domain": 0,
              "requests": 1,
              "client_errors": 2,
              "server_errors": 3,
              "clients": 4,
              "p95": 5,
              "Time": 6
            },
            "renameByName": {
              "url.domain": "Site",
              "requests": "Requests",
              "client_errors": "4xx",
              "server_errors": "5xx",
              "clients": "Clients",
              "p95": "p95",
              "Time": "Last seen"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
