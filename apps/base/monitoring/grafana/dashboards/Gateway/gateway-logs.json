{
  "uid": "gateway-logs",
  "title": "Gateway logs",
  "description": "Requests through the Gateway from Envoy's access log (envoy.access in VictoriaLogs): sites, clients, paths, errors.",
  "tags": [
    "gateway"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "site",
        "label": "Site (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "description": "A regular expression on url.domain, e.g. grafana\\..* or (sonarr|radarr)\\..*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Security",
      "type": "dashboards",
      "tags": [
        "security"
      ],
      "asDropdown": false
    }
  ],
  "id": null,
  "panels": [
    {
      "type": "row",
      "title": "Requests",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests",
      "id": 2,
      "description": "Requests through the Gateway in the time range.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "stats",
          "expr": "_time:$__range {event.dataset=\"envoy.access\"} url.domain:~\"${site}\" | count() as requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
