    {
      "type": "table",
      "title": "Why",
      "id": 7,
      "description": "Each dataset's pipeline errors by reason (error.message), the latest first.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "_time:$__range {event.kind=\"pipeline_error\"} | stats by (event.dataset, error.type, error.message) count() as lines, max(_time) as last | sort by (last desc) | limit 50"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "lines",
                "destinationType": "number"
              }
            ]
          }
        },
