    {
      "type": "stat",
      "title": "Over a minute late",
      "id": 16,
      "description": "Lines that took more than 60 seconds, as a share of all.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "_time:$__range event.ingested:* | math (event.ingested - _time) / 1e9 as delay | stats count() if (delay:>60) as late, count() as lines | math late / lines * 100 as late | fields late",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
