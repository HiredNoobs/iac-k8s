    {
      "type": "timeseries",
      "title": "Events/s by source",
      "id": 17,
      "description": "Lines each of Vector's sources read per second, all the collectors together. The aggregator's collectors source is left out: it's Envoy's lines a second time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (component_id) (rate(vector_component_received_events_total{job=\"vector\", component_kind=\"source\", component_id!~\"internal|collectors\"}[$__rate_interval]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{component_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Events/s by dataset prefix",
      "id": 21,
      "description": "Lines per second. By the part of event.dataset before the dot: the app for parsed logs (talos, envoy, vault), the namespace for other pods.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "event.dataset:* | extract_regexp \"^(?P<prefix>[^.]+)\" from event.dataset | stats by (prefix) rate() as eps",
          "queryType": "statsRange",
          "legendFormat": "{{prefix}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Waiting in Vector's buffers",
      "id": 20,
      "description": "Lines each Vector holds for a sink that hasn't taken them yet (VictoriaLogs, the aggregator). Growing means that sink is down or slow (VectorSinkStalled).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (pod, component_id) (vector_buffer_size_events{job=\"vector\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{pod}} {{component_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
