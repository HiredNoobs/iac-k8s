{
  "uid": "security-investigation",
  "title": "Investigation",
  "description": "Everything about one client (IP) and/or user in the time range. Set the variables, or click a client in Security overview.",
  "tags": [
    "security"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "ip",
        "label": "Client IP (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "description": "A client's address, e.g. 192.168.50.140. .* is everyone."
      },
      {
        "type": "textbox",
        "name": "user",
        "label": "User (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "description": "An Authelia/lldap username or a Vaultwarden email. .* is everyone."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Security",
      "type": "dashboards",
      "tags": [
        "security"
      ],
      "asDropdown": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Detections",
      "id": 33,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Detections",
      "id": 34,
      "description": "Alert instances in the time range whose rule extracted this client or user.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (alertname, mitre_tactic, mitre_technique, severity, remote_ip, user) (max_over_time(ALERTS{alertstate=\"firing\", mitre_tactic!=\"\", remote_ip=~\"${ip}\", user=~\"${user}\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "alertgroup": true,
              "cluster": true,
              "job": true,
              "instance": true,
              "Value": true,
              "stats_result": true
            },
            "renameByName": {
              "alertname": "Detection",
              "mitre_tactic": "Tactic",
              "mitre_technique": "Technique",
              "severity": "Severity",
              "source": "Source",
              "remote_ip": "Client",
              "user": "User"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Gateway (client)",
      "id": 35,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "table",
      "title": "Requests by site and status",
      "id": 36,
      "description": "This client's requests through the Gateway.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "_time:$__range {kubernetes.pod_namespace=\"envoy-gateway\",kubernetes.container_name=\"envoy\"} downstream_remote_address:~\"^${ip}:\" | copy \":authority\" as host | stats by (host, response_code) count() as requests, uniq_values(\"x-envoy-origin-path\") limit 5 as examples, max(_time) as _time | replace_regexp (\"^\\\\[\\\\]$|^\\\\[\\\"|\\\"\\\\]$\", \"\") at examples | replace (\"\\\",\\\"\", \", \") at examples | replace (\"\\\\\\\"\", \"\\\"\") at examples | replace (\"\\\\u0027\", \"'\") at examples | replace (\"\\\\u003c\", \"<\") at examples | replace (\"\\\\u003e\", \">\") at examples | replace (\"\\\\u0026\", \"&\") at examples | sort by (requests desc) | limit 50"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "requests",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true
            },
            "indexByName": {
              "host": 0,
              "response_code": 1,
              "requests": 2,
              "examples": 3,
              "Time": 4
            },
            "renameByName": {
              "host": "Site",
              "response_code": "Status",
              "requests": "Requests",
              "examples": "Example paths",
              "Time": "Last seen"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "User agents",
      "id": 37,
      "description": "The clients' user agents: a browser, curl, a scanner, an app.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "_time:$__range {kubernetes.pod_namespace=\"envoy-gateway\",kubernetes.container_name=\"envoy\"} downstream_remote_address:~\"^${ip}:\" | stats by (\"user-agent\") count() as requests, max(_time) as _time | sort by (requests desc) | limit 20"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "requests",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true
            },
            "indexByName": {
              "user-agent": 0,
              "requests": 1,
              "Time": 2,
              "examples": 3
            },
            "renameByName": {
              "user-agent": "User agent",
              "requests": "Requests",
              "Time": "Last seen"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "logs",
      "title": "Gateway requests",
      "id": 38,
      "description": "This client's requests, newest first (/static/ files left out).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{kubernetes.pod_namespace=\"envoy-gateway\",kubernetes.container_name=\"envoy\"} downstream_remote_address:~\"^${ip}:\" -\"/static/\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    },
    {
      "type": "row",
      "title": "Logins (client and user)",
      "id": 39,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "logs",
      "title": "Authelia",
      "id": 40,
      "description": "Authelia's lines for this client and user (failed logins, bans, unknown usernames).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{kubernetes.pod_namespace=\"authelia\",kubernetes.container_name=\"authelia\"} remote_ip:~\"^${ip}$\" _msg:~\"user(name input)? '${user}'\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    },
    {
      "type": "logs",
      "title": "Vaultwarden",
      "id": 41,
      "description": "Vaultwarden's failed logins for this client and user (it logs nothing for a success).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{kubernetes.pod_namespace=\"vaultwarden\",kubernetes.container_name=\"vaultwarden\"} _msg:~\"IP: ${ip}[.] Username: ${user}[.]$\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    },
    {
      "type": "row",
      "title": "Directory (user)",
      "id": 42,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      }
    },
    {
      "type": "logs",
      "title": "lldap-bootstrap changes",
      "id": 43,
      "description": "Reverted changes that mention this user.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{kubernetes.pod_namespace=\"lldap\",kubernetes.container_name=\"bootstrap\"} (\"successfully created\" or \"successfully deleted\" or \"successfully added to the group\" or \"successfully removed from the group\" or \"[WARNING]\") _msg:~\"\\\"${user}\\\"\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    },
    {
      "type": "row",
      "title": "Kubernetes API (client and user)",
      "id": 44,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 47
      }
    },
    {
      "type": "logs",
      "title": "Audit log",
      "id": 45,
      "description": "This client's and user's Kubernetes API requests (what the audit policy keeps).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{source=\"kube-audit\"} remote_ip:~\"^${ip}$\" user.username:~\"^${user}$\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    },
    {
      "type": "row",
      "title": "prx-999 hosts (client and user)",
      "id": 46,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 58
      }
    },
    {
      "type": "logs",
      "title": "Vault",
      "id": 47,
      "description": "Vault's audit log (responses) for this client and identity.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 59
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{_SYSTEMD_UNIT=\"vault.service\"} \"\\\"type\\\":\\\"response\\\"\" | unpack_json fields (request.remote_address, auth.display_name) | filter request.remote_address:~\"^${ip}$\" auth.display_name:~\"${user}\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    },
    {
      "type": "logs",
      "title": "Journals",
      "id": 48,
      "description": "The VMs' journal lines mentioning this client and user (SSH, sudo, Forgejo).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 59
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{_HOSTNAME=~\"prx-999-.*\"} -_SYSTEMD_UNIT:=\"vault.service\" _msg:~\"${ip}\" _msg:~\"${user}\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    }
  ],
  "id": null
}
