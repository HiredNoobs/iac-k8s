{
  "uid": "security-overview",
  "title": "Security overview",
  "description": "Detections (alerts with ATT&CK labels), logins and Gateway requests. Click a client to investigate it.",
  "tags": [
    "security"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Security",
      "type": "dashboards",
      "tags": [
        "security"
      ],
      "asDropdown": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Detections",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Firing now",
      "id": 2,
      "description": "Detections (alerts with ATT&CK labels) firing now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", mitre_tactic!=\"\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Fired in range",
      "id": 3,
      "description": "Alert instances the detections raised in the time range (VictoriaMetrics keeps 7 days).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count_over_time(ALERTS{alertstate=\"firing\", mitre_tactic!=\"\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Failed logins",
      "id": 4,
      "description": "Wrong passwords and TOTP codes in Authelia, failed Vaultwarden logins.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "stats",
          "expr": "_time:$__range {kubernetes.pod_namespace=~\"authelia|vaultwarden\"} (\"Unsuccessful 1FA\" or \"Unsuccessful TOTP\" or \"Username or password is incorrect\") | count() as failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Authelia logins",
      "id": 5,
      "description": "Completed Authelia logins (password and TOTP), from the Gateway's logs.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "stats",
          "expr": "_time:$__range {kubernetes.pod_namespace=\"envoy-gateway\",kubernetes.container_name=\"envoy\"} method:=POST response_code:=200 \":authority\":=\"auth.hirednoobs.com\" \"x-envoy-origin-path\":=\"/api/secondfactor/totp\" | count() as logins"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Refused requests",
      "id": 6,
      "description": "401/403/404 responses at the Gateway, blackbox probes excluded.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "stats",
          "expr": "_time:$__range {kubernetes.pod_namespace=\"envoy-gateway\",kubernetes.container_name=\"envoy\"} response_code:in(\"401\", \"403\", \"404\") -\"user-agent\":\"Blackbox-Exporter\"* | count() as refused"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Sensitive requests",
      "id": 7,
      "description": "Scanner paths and sensitive actions (silences, deletes, Grafana users, Vaultwarden's admin panel) at the Gateway.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "stats",
          "expr": "_time:$__range {kubernetes.pod_namespace=\"envoy-gateway\",kubernetes.container_name=\"envoy\"} (\"x-envoy-origin-path\":~\"(?i)(/\\\\.env|/\\\\.git/|/\\\\.aws/|wp-login\\\\.php|/wp-admin|phpmyadmin|/cgi-bin/|\\\\.\\\\./|%2e%2e)\" or (\":authority\":=\"alertmanager.hirednoobs.com\" method:=POST \"x-envoy-origin-path\":=\"/api/v2/silences\") or (\":authority\":=\"victoriametrics.hirednoobs.com\" \"x-envoy-origin-path\":~\"^/api/v1/admin/tsdb/delete_series\") or (\":authority\":=\"victorialogs.hirednoobs.com\" \"x-envoy-origin-path\":~\"^/delete/\") or (\":authority\":=\"grafana.hirednoobs.com\" method:in(\"POST\", \"PUT\", \"PATCH\", \"DELETE\") \"x-envoy-origin-path\":~\"^/api/(admin/users|org/users)\") or (\":authority\":=\"vaultwarden.hirednoobs.com\" \"x-envoy-origin-path\":~\"^/admin\")) -response_code:=302 | count() as requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Detections by tactic",
      "id": 8,
      "description": "Firing detections over time, by ATT&CK tactic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (mitre_tactic) (ALERTS{alertstate=\"firing\", mitre_tactic!=\"\"})",
          "legendFormat": "{{mitre_tactic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Detections in range",
      "id": 9,
      "description": "Each detection's alert instances in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (alertname, mitre_tactic, mitre_technique, severity) (count_over_time(ALERTS{alertstate=\"firing\", mitre_tactic!=\"\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "alertname": "Detection",
              "mitre_tactic": "Tactic",
              "mitre_technique": "Technique",
              "severity": "Severity",
              "source": "Source",
              "remote_ip": "Client",
              "user": "User",
              "Value": "Instances"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Instances",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Firing now",
      "id": 10,
      "description": "Detections firing now, with the labels their rule extracted. Click a client to investigate it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\", mitre_tactic!=\"\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "alertgroup": true,
              "cluster": true,
              "job": true,
              "instance": true,
              "Value": true,
              "stats_result": true
            },
            "renameByName": {
              "alertname": "Detection",
              "mitre_tactic": "Tactic",
              "mitre_technique": "Technique",
              "severity": "Severity",
              "source": "Source",
              "remote_ip": "Client",
              "user": "User"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "remote_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Investigate this client",
                    "url": "/d/security-investigation/investigation?var-ip=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Authentication",
      "id": 11,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Login failures",
      "id": 12,
      "description": "Authelia: wrong passwords and TOTP codes (its logs). Vaultwarden: failed logins, which it logs the same for a wrong password and an unknown account.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "expr": "{kubernetes.pod_namespace=\"authelia\",kubernetes.container_name=\"authelia\"} \"Unsuccessful 1FA\" | stats count() as failures",
          "legendFormat": "Authelia password"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "expr": "{kubernetes.pod_namespace=\"authelia\",kubernetes.container_name=\"authelia\"} \"Unsuccessful TOTP\" | stats count() as failures",
          "legendFormat": "Authelia TOTP"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "expr": "{kubernetes.pod_namespace=\"vaultwarden\",kubernetes.container_name=\"vaultwarden\"} \"Username or password is incorrect\" | stats count() as failures",
          "legendFormat": "Vaultwarden"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Successful logins",
      "id": 13,
      "description": "From the Gateway's logs: completed Authelia logins, and Vaultwarden logins or token refreshes (clients refresh about hourly; the log can't tell them apart).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "expr": "{kubernetes.pod_namespace=\"envoy-gateway\",kubernetes.container_name=\"envoy\"} method:=POST response_code:=200 ((\":authority\":=\"auth.hirednoobs.com\" \"x-envoy-origin-path\":=\"/api/secondfactor/totp\") or (\":authority\":=\"vaultwarden.hirednoobs.com\" \"x-envoy-origin-path\":=\"/identity/connect/token\")) | copy \":authority\" as host | stats by (host) count() as logins",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Authelia failures",
      "id": 14,
      "description": "Failed Authelia logins (password or TOTP) by user and client.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "stats",
          "expr": "_time:$__range {kubernetes.pod_namespace=\"authelia\",kubernetes.container_name=\"authelia\"} (\"Unsuccessful 1FA\" or \"Unsuccessful TOTP\") | extract \"Unsuccessful <factor> authentication attempt by user '<user>'\" | stats by (user, remote_ip, factor) count() as failures | sort by (failures desc) | limit 50"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "user": "User",
              "remote_ip": "Client",
              "factor": "Factor",
              "failures": "Failures"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Failures",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "remote_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Investigate this client",
                    "url": "/d/security-investigation/investigation?var-ip=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Vaultwarden failures",
      "id": 15,
      "description": "Failed Vaultwarden logins by user and client.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "stats",
          "expr": "_time:$__range {kubernetes.pod_namespace=\"vaultwarden\",kubernetes.container_name=\"vaultwarden\"} \"Username or password is incorrect\" | extract_regexp \"IP: (?P<remote_ip>\\\\S+)\\\\. Username: (?P<user>.*)\\\\.$\" | stats by (user, remote_ip) count() as failures | sort by (failures desc) | limit 50"
        }
      ],
      "transformations": [
        {
