%% The nodes talk to each other (and the CLI tools to the node) over TLS with the node's
%% certificate, which names every node (certificate.yaml), checked against rabbitmq-ca both ways.
%% Used through -ssl_dist_optfile (statefulset.yaml).
[
  {server, [
    {cacertfile, "/etc/rabbitmq/tls/ca.crt"},
    {certfile, "/etc/rabbitmq/tls/tls.crt"},
    {keyfile, "/etc/rabbitmq/tls/tls.key"},
    {secure_renegotiate, true},
    {verify, verify_peer},
    {fail_if_no_peer_cert, true}
  ]},
  {client, [
    {cacertfile, "/etc/rabbitmq/tls/ca.crt"},
    {certfile, "/etc/rabbitmq/tls/tls.crt"},
    {keyfile, "/etc/rabbitmq/tls/tls.key"},
    {secure_renegotiate, true},
    {verify, verify_peer}
  ]}
].
